# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API-Football (api-sports.io)
# Sin prefijo VITE_: se usa solo del lado del servidor (proxy de vite.config.ts
# en dev, netlify/functions/football.js en prod). Nunca debe llegar al browser.
FOOTBALL_API_KEY=your-api-football-key-here

# NOTE: Never commit real credentials to git!
# Copy this file to .env.local and fill in real values
